# Django settings
DJANGO_SECRET_KEY=django-insecure-oer-hub-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database settings (sqlite3 for dev, postgresql for prod)
DJANGO_DB_ENGINE=sqlite3
POSTGRES_DB=oer_hub
POSTGRES_USER=oer_user
POSTGRES_PASSWORD=oer_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Django Superuser credentials
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpassword123

# Gitea configuration
GITEA_URL=http://gitea:3000
GITEA_EXTERNAL_URL=http://localhost:3000
GITEA_ADMIN_USERNAME=gitea_admin
GITEA_ADMIN_PASSWORD=gitea_admin_password
GITEA_ADMIN_TOKEN=
GITEA_ORG_NAME=department-oer

# Redis
REDIS_URL=redis://redis:6379/0
